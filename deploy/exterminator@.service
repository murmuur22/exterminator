[Unit]
Description=WE exterminator %i surface
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=exterminator
Group=exterminator
WorkingDirectory=/opt/exterminator/current
ExecStart=/opt/exterminator/current/venv/bin/python -B /opt/exterminator/current/production.py %i
Environment=PYTHONUNBUFFERED=1
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/exterminator
InaccessiblePaths=-/var/backups/exterminator
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
TasksMax=32
MemoryMax=256M
CPUQuota=100%
LimitNOFILE=1024
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
